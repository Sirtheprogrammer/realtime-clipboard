{
  "manifest_version": 3,
  "name": "Clipboard Vault — Credential & Secret Manager",
  "version": "1.2.0",
  "description": "Securely save, autofill, and synchronize encrypted passwords, tokens, and API keys across all your devices.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "update_url": "https://clip.codesky.tech/api/extension/updates.xml",
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clipboard Vault"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vault@clip.codesky.tech",
      "strict_min_version": "109.0",
      "update_url": "https://clip.codesky.tech/api/extension/updates.json"
    }
  }
}
